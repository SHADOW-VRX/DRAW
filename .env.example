# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_EXPIRY_MS=1800000
SESSION_CLEANUP_INTERVAL_MS=60000
MAX_SESSIONS=500

# Security — comma-separated list of allowed origins.
# On Render, set this to your deployed URL:
#   ALLOWED_ORIGINS=https://your-app-name.onrender.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAX_PAYLOAD_BYTES=1048576
WS_RATE_LIMIT_PER_MIN=120

# TURN relay (optional but recommended for reliable WebRTC
# across mobile carriers and symmetric NATs).
# Example for coturn or a managed TURN provider:
#   TURN_URL=turn:relay.example.com:3478
#   TURN_USERNAME=draw
#   TURN_CREDENTIAL=replace-with-a-strong-secret
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=